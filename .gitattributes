# Ensure consistent LF line endings for files that affect build checksums
*.sql    text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.ts     text eol=lf
*.svelte text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.webp   binary
*.ico    binary
*.woff2  binary
