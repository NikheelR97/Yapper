{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yapper",
  "version": "0.1.0",
  "identifier": "com.yapperhq.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yapper",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8080 ws://localhost:8080 https://api.yapperhq.com wss://api.yapperhq.com https://*.r2.cloudflarestorage.com; img-src 'self' data: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "host": "yapperhq.com",
          "pathPrefix": [
            "/invite"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "yapper"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDMEY5OUUzMUFBRkJGRkIKUlVsKzhmK3B2KzkvT3pITkE3TjR4VUVnSTh5Skc3WEZlNWozNUp5S29NSC8K",
      "endpoints": [
        "https://github.com/YapperHQ/yapper/releases/latest/download/latest.json"
      ]
    }
  }
}