# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: postgres://yapper:yapper_dev@localhost:5432/yapper
# Production: Neon connection string (add ?sslmode=require)
DATABASE_URL=postgres://yapper:yapper_dev@localhost:5432/yapper

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out jwt_private.pem 2048
# Then: openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./jwt_private.pem
JWT_PUBLIC_KEY_PATH=./jwt_public.pem

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,tauri://localhost,capacitor://localhost

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=yapper-media
# R2 endpoint: https://{account_id}.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# Public base URL for media reads
R2_PUBLIC_URL=https://media.yapper.app

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Yapper <hello@yapper.app>

# ─── OAuth ───────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
# OAuth redirect base URL
OAUTH_REDIRECT_BASE=http://localhost:8080

# ─── Firebase (FCM push notifications) ───────────────────────────────────────
# Path to downloaded service-account.json from Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# Leave empty to disable in local dev
SENTRY_DSN=

# ─── App ─────────────────────────────────────────────────────────────────────
RUST_LOG=info,yapper_server=debug
APP_ENV=development
