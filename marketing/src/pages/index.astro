---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import AppShowcase from '../components/AppShowcase.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ProductDemos from '../components/ProductDemos.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SafetySection from '../components/SafetySection.astro';
import PlatformBadges from '../components/PlatformBadges.astro';
import PricingPreview from '../components/PricingPreview.astro';
import FAQAccordion from '../components/FAQAccordion.svelte';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main>
    <Hero />
    <AppShowcase />
    <FeatureGrid />
    <ProductDemos />
    <HowItWorks />
    <SafetySection />
    <PlatformBadges />
    <PricingPreview />
    <FAQAccordion client:load />
  </main>
  <Footer />
</Base>
