---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Terms of Service — Yapper"
  description="Yapper Terms of Service. The rules governing your use of the Yapper platform."
>
  <Nav />
  <main class="legal-page">
    <div class="container">
      <header class="legal-header">
        <div class="legal-badge">Legal</div>
        <h1>Terms of Service</h1>
        <div class="legal-meta">
          <span>Effective: <strong>March 16, 2026</strong></span>
          <span class="sep">·</span>
          <span>Questions: <a href="mailto:legal@yapperhq.com">legal@yapperhq.com</a></span>
        </div>
        <p class="legal-intro">
          These Terms of Service govern your access to and use of the Yapper platform. By creating
          an account or using the Service, you agree to these Terms.
        </p>
      </header>

      <div class="legal-layout">
        <nav class="toc" aria-label="Table of contents">
          <p class="toc-label">Contents</p>
          <ol>
            <li><a href="#s1">Agreement to Terms</a></li>
            <li><a href="#s2">Eligibility</a></li>
            <li><a href="#s3">Accounts</a></li>
            <li><a href="#s4">Acceptable Use</a></li>
            <li><a href="#s5">Your Content</a></li>
            <li><a href="#s6">Encryption &amp; Privacy</a></li>
            <li><a href="#s7">Premium &amp; Payments</a></li>
            <li><a href="#s8">Desktop &amp; Mobile Apps</a></li>
            <li><a href="#s9">Third-Party Services</a></li>
            <li><a href="#s10">Intellectual Property</a></li>
            <li><a href="#s11">Termination</a></li>
            <li><a href="#s12">Disclaimers</a></li>
            <li><a href="#s13">Limitation of Liability</a></li>
            <li><a href="#s14">Indemnification</a></li>
            <li><a href="#s15">Governing Law</a></li>
            <li><a href="#s16">Changes to Terms</a></li>
            <li><a href="#s17">Contact</a></li>
          </ol>
        </nav>

        <article class="legal-body">

          <section id="s1">
            <h2>1. Agreement to Terms</h2>
            <p>
              By accessing or using the Yapper platform — including our website at
              <strong>yapperhq.com</strong>, our web application at <strong>app.yapperhq.com</strong>,
              our desktop application, or our mobile apps (collectively, the "Service") — you agree to
              be bound by these Terms of Service ("Terms") and our
              <a href="/privacy">Privacy Policy</a>.
            </p>
            <p>
              These Terms form a binding legal agreement between you and Yapper Technologies, Inc.
              ("Yapper," "we," "our," or "us"), a company registered in KwaZulu-Natal, South Africa. If you do not agree to these Terms, do not use the Service.
            </p>
          </section>

          <section id="s2">
            <h2>2. Eligibility</h2>
            <h3>2.1 Minimum Age</h3>
            <p>
              You must be at least 13 years old to create an account. If you are under 13, you may
              only use Yapper with verifiable parental consent, and a parent or guardian must create
              the account on your behalf. By creating an account, you represent that you meet these
              age requirements.
            </p>
            <h3>2.2 Parental Consent for Minors (Under 13)</h3>
            <p>
              If you are a parent or guardian creating an account for a child under 13, you represent
              that you have authority to agree to these Terms on behalf of the minor, and you accept
              responsibility for the minor's use of the Service. You acknowledge that Yapper's
              parental controls are available to help manage your child's activity on the platform.
            </p>
            <h3>2.3 Legal Capacity</h3>
            <p>
              By agreeing to these Terms, you represent that you have the legal capacity to enter into
              a binding agreement, and that you are not prohibited from using the Service under
              applicable laws.
            </p>
          </section>

          <section id="s3">
            <h2>3. Accounts</h2>
            <h3>3.1 Registration</h3>
            <p>
              To access most features of the Service, you must register for an account. You agree to
              provide accurate, current, and complete information during registration and to keep your
              account information up to date.
            </p>
            <h3>3.2 Account Security</h3>
            <p>
              You are responsible for maintaining the confidentiality of your login credentials and
              for all activity that occurs under your account. You must notify us immediately at
              <a href="mailto:security@yapperhq.com">security@yapperhq.com</a> if you become aware of
              any unauthorized access to your account.
            </p>
            <h3>3.3 One Account Per Person</h3>
            <p>
              Each user may maintain only one personal account. You may not create accounts on behalf
              of others without authorization. Automated account creation is prohibited.
            </p>
            <h3>3.4 Username Policy</h3>
            <p>
              Usernames must not impersonate other people or organizations, include offensive or
              harmful language, or otherwise violate these Terms or our Community Guidelines. We
              reserve the right to reclaim usernames that violate this policy.
            </p>
          </section>

          <section id="s4">
            <h2>4. Acceptable Use</h2>
            <h3>4.1 You May Not Use the Service To:</h3>
            <ul>
              <li>Violate any applicable law or regulation, including laws governing privacy, data protection, intellectual property, spam, export controls, or anti-money laundering.</li>
              <li>Harass, bully, threaten, intimidate, or harm any person.</li>
              <li>Post, transmit, or distribute child sexual abuse material (CSAM) or any content that sexually exploits or harms minors. We report all CSAM to the National Center for Missing and Exploited Children (NCMEC) and relevant law enforcement.</li>
              <li>Distribute malware, spyware, ransomware, or other malicious code.</li>
              <li>Attempt to gain unauthorized access to Yapper's systems, infrastructure, or user accounts.</li>
              <li>Conduct denial-of-service attacks or otherwise disrupt the Service.</li>
              <li>Scrape, crawl, or systematically extract data from the Service without our written permission.</li>
              <li>Circumvent rate limits, authentication, or access controls.</li>
              <li>Use the Service for spam, phishing, or any unsolicited bulk communications.</li>
              <li>Impersonate any person, organization, or brand in a way that is deceptive or misleading.</li>
              <li>Facilitate real-money gambling without appropriate licensing in applicable jurisdictions.</li>
              <li>Coordinate real-world violence, terrorism, or other illegal activities.</li>
            </ul>
            <h3>4.2 Bot and Automation Policy</h3>
            <p>
              You may create and operate bots on Yapper in accordance with our Bot Developer Terms.
              Bots must be clearly identified as bots and must not be used to violate these Terms or
              to manipulate the Service.
            </p>
            <h3>4.3 Rate Limits</h3>
            <p>
              The Service enforces rate limits (100 requests per minute per IP, 5 messages per second
              per user via WebSocket). Attempting to circumvent these limits is prohibited and may
              result in temporary or permanent suspension.
            </p>
          </section>

          <section id="s5">
            <h2>5. Your Content</h2>
            <h3>5.1 Ownership</h3>
            <p>
              You retain ownership of all content you post, send, or share through the Service ("Your
              Content"). By using the Service, you do not transfer ownership of Your Content to
              Yapper.
            </p>
            <h3>5.2 License to Yapper</h3>
            <p>
              For non-encrypted content (such as server names, descriptions, icons, custom emojis,
              profile information, and poll content), you grant Yapper a limited, worldwide,
              royalty-free, non-exclusive license to display, store, transmit, and cache Your Content
              as necessary to provide and operate the Service.
            </p>
            <p>
              For end-to-end encrypted content (messages, Voice Yaps, Video Clips, and file
              attachments), Yapper receives only encrypted ciphertext and cannot access or use the
              content itself. No content license is granted for such encrypted material beyond the
              technical operations needed to route and store ciphertext.
            </p>
            <h3>5.3 Content Responsibility</h3>
            <p>
              You are solely responsible for Your Content and the consequences of sharing it. You
              represent and warrant that you have all necessary rights to share Your Content and that
              it does not violate these Terms, applicable law, or the rights of any third party.
            </p>
            <h3>5.4 Content Removal</h3>
            <p>
              Yapper reserves the right to remove or disable access to any non-encrypted content that
              violates these Terms or our Community Guidelines, or that we are required to remove by
              law. Due to E2EE, we cannot proactively review encrypted message content.
            </p>
          </section>

          <section id="s6">
            <h2>6. Encryption and Privacy</h2>
            <h3>6.1 End-to-End Encryption</h3>
            <p>
              Yapper uses the Signal Protocol (X3DH + Double Ratchet for direct messages, Sender Keys
              for group channels) to provide end-to-end encryption for your messages. Your private
              encryption keys are generated on your device and never transmitted to Yapper's servers
              in plaintext.
            </p>
            <h3>6.2 Key Responsibility</h3>
            <p>
              You are responsible for maintaining access to your encryption keys. Loss of your device
              without an active key backup means you may lose access to your encrypted message
              history. Yapper is not liable for lost message access due to key loss.
            </p>
            <h3>6.3 No Backdoors</h3>
            <p>
              Yapper has no backdoor access to the plaintext content of your E2EE communications. We
              cannot decrypt your messages even in response to law enforcement requests. We will
              provide only encrypted ciphertext and metadata in response to valid legal demands.
            </p>
            <h3>6.4 Reporting Encrypted Content</h3>
            <p>
              If you report a message to Yapper, you acknowledge that you are consenting to transmit
              the decrypted content of that specific message to our Trust &amp; Safety team for the
              purpose of investigation. Yapper will use the reported content only to investigate the
              report and take appropriate action.
            </p>
          </section>

          <section id="s7">
            <h2>7. Premium Subscriptions and Payments</h2>
            <h3>7.1 Premium Features</h3>
            <p>
              Yapper offers optional paid features through Yapper Premium subscriptions and server
              boosts. By subscribing, you agree to pay the applicable fees displayed at the time of
              purchase.
            </p>
            <h3>7.2 Billing</h3>
            <p>
              All payments are processed by Stripe. Your subscription will automatically renew at the
              end of each billing period unless cancelled. Prices are listed in USD and are exclusive
              of applicable taxes, which may be added at checkout.
            </p>
            <h3>7.3 Cancellation and Refunds</h3>
            <p>
              You may cancel your subscription at any time from your account settings. Cancellation
              takes effect at the end of the current billing period; you will retain access to Premium
              features until that date. We do not offer refunds for partial billing periods, except
              where required by applicable law.
            </p>
            <h3>7.4 Promo Codes</h3>
            <p>
              Promotional codes may be used once per account and are subject to expiry dates and
              restrictions communicated at the time of distribution. Promo codes have no cash value
              and cannot be transferred.
            </p>
            <h3>7.5 Price Changes</h3>
            <p>
              We may change subscription prices with at least 30 days' advance notice via email and
              in-app notification. Your continued subscription after the effective date of a price
              change constitutes acceptance of the new price.
            </p>
          </section>

          <section id="s8">
            <h2>8. Desktop and Mobile Applications</h2>
            <h3>8.1 License to Use</h3>
            <p>
              We grant you a limited, non-exclusive, non-transferable, revocable license to download
              and use the Yapper desktop application (Tauri) and mobile applications (iOS and Android)
              solely for your personal, non-commercial use on devices you own or control.
            </p>
            <h3>8.2 Updates</h3>
            <p>
              The desktop application may download and install updates automatically. We recommend
              keeping your applications up to date to benefit from security patches and new features.
            </p>
            <h3>8.3 App Store Terms</h3>
            <p>
              Your use of the mobile applications may also be subject to the terms of the App Store
              (Apple App Store or Google Play) through which you downloaded the application. These
              Terms govern your use of the Yapper application itself; App Store terms govern the
              distribution relationship.
            </p>
          </section>

          <section id="s9">
            <h2>9. Third-Party Services and Integrations</h2>
            <p>
              The Service integrates with third-party services including Discord (profile and bot
              import), Google (OAuth sign-in), Stripe (payments), and others. Your use of these
              third-party services is subject to their own terms and privacy policies. Yapper is not
              responsible for the practices or content of third-party services.
            </p>
            <p>
              Third-party bots and integrations added to servers operate independently of Yapper. You
              should review the permissions requested by any bot before adding it to your server.
              Yapper is not liable for the actions of third-party bots or integrations.
            </p>
          </section>

          <section id="s10">
            <h2>10. Intellectual Property</h2>
            <h3>10.1 Yapper's IP</h3>
            <p>
              The Yapper name, logo, branding, design, and software (excluding Your Content) are owned
              by or licensed to Yapper Technologies, Inc. and protected by copyright, trademark, and
              other intellectual property laws. These Terms do not grant you any rights to use
              Yapper's intellectual property except as expressly permitted.
            </p>
            <h3>10.2 Feedback</h3>
            <p>
              If you submit feedback, suggestions, or ideas about the Service, you grant Yapper a
              perpetual, irrevocable, royalty-free license to use that feedback for any purpose
              without compensation to you.
            </p>
            <h3>10.3 Copyright Complaints (DMCA)</h3>
            <p>
              If you believe that content on the Service infringes your copyright, please contact us
              at <a href="mailto:legal@yapperhq.com">legal@yapperhq.com</a> with a DMCA takedown
              notice containing: identification of the copyrighted work, identification of the
              allegedly infringing content, your contact information, and a statement made under
              penalty of perjury that you are authorized to act on behalf of the copyright owner.
            </p>
          </section>

          <section id="s11">
            <h2>11. Termination</h2>
            <h3>11.1 Termination by You</h3>
            <p>
              You may delete your account at any time from Settings → Account → Delete Account. Upon
              deletion, your account and associated Personal Data will be permanently removed from our
              systems within 30 days, subject to data we are legally required to retain (see our
              <a href="/privacy">Privacy Policy</a>, Section 12).
            </p>
            <h3>11.2 Termination by Yapper</h3>
            <p>
              We may suspend or terminate your account at any time if we determine, in our sole
              discretion, that you have violated these Terms, applicable law, or our Community
              Guidelines. We will make reasonable efforts to notify you before termination except
              where immediate action is required (e.g., for serious violations involving harm to
              others).
            </p>
            <h3>11.3 Effect of Termination</h3>
            <p>
              Upon termination, your right to use the Service ceases immediately. Provisions of these
              Terms that by their nature should survive termination (including Sections 5.1, 10, 12,
              13, and 14) will survive.
            </p>
          </section>

          <section id="s12">
            <h2>12. Disclaimers</h2>
            <p>
              THE SERVICE IS PROVIDED "AS IS" AND "AS AVAILABLE" WITHOUT WARRANTIES OF ANY KIND,
              EITHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO WARRANTIES OF MERCHANTABILITY,
              FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.
            </p>
            <p>
              YAPPER DOES NOT WARRANT THAT THE SERVICE WILL BE UNINTERRUPTED, ERROR-FREE, OR SECURE.
              WE DO NOT WARRANT THAT DEFECTS WILL BE CORRECTED OR THAT THE SERVICE IS FREE OF VIRUSES
              OR OTHER HARMFUL COMPONENTS.
            </p>
            <p>
              YOU USE THE SERVICE AT YOUR OWN RISK. YAPPER IS NOT RESPONSIBLE FOR THE CONTENT, ACTIONS,
              OR OMISSIONS OF THIRD PARTIES, INCLUDING OTHER USERS, BOTS, OR EXTERNAL SERVICES.
            </p>
            <p>
              Some jurisdictions do not allow the exclusion of implied warranties, so some of the above
              exclusions may not apply to you.
            </p>
          </section>

          <section id="s13">
            <h2>13. Limitation of Liability</h2>
            <p>
              TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, YAPPER AND ITS OFFICERS, DIRECTORS,
              EMPLOYEES, AND AGENTS SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL,
              CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING LOSS OF PROFITS, DATA, GOODWILL, OR OTHER
              INTANGIBLE LOSSES, ARISING FROM OR RELATING TO YOUR USE OF (OR INABILITY TO USE) THE
              SERVICE.
            </p>
            <p>
              IN NO EVENT SHALL YAPPER'S TOTAL LIABILITY TO YOU FOR ALL CLAIMS ARISING FROM THESE
              TERMS OR YOUR USE OF THE SERVICE EXCEED THE AMOUNT YOU PAID TO YAPPER IN THE TWELVE
              MONTHS PRECEDING THE CLAIM, OR $100 USD, WHICHEVER IS GREATER.
            </p>
            <p>
              Some jurisdictions do not allow the limitation of liability for certain types of
              damages, so some of the above limitations may not apply to you.
            </p>
          </section>

          <section id="s14">
            <h2>14. Indemnification</h2>
            <p>
              You agree to indemnify, defend, and hold harmless Yapper Technologies, Inc. and its
              officers, directors, employees, and agents from and against any claims, liabilities,
              damages, losses, and expenses (including reasonable legal fees) arising from or related
              to: (a) your use of the Service; (b) Your Content; (c) your violation of these Terms or
              applicable law; or (d) your violation of any third party's rights.
            </p>
          </section>

          <section id="s15">
            <h2>15. Governing Law and Dispute Resolution</h2>
            <h3>15.1 Governing Law</h3>
            <p>
              These Terms shall be governed by and construed in accordance with the laws of the
              Republic of South Africa, without regard to its conflict of law principles. Users in the
              EEA may also have rights under applicable EU consumer protection laws that cannot be
              excluded by this clause.
            </p>
            <h3>15.2 Dispute Resolution</h3>
            <p>
              We encourage you to contact us first at <a href="mailto:legal@yapperhq.com">legal@yapperhq.com</a>
              to attempt to resolve any dispute informally. If a dispute cannot be resolved informally,
              it shall be submitted to the courts of competent jurisdiction in KwaZulu-Natal, South
              Africa, unless applicable law requires otherwise.
            </p>
            <h3>15.3 Class Action Waiver</h3>
            <p>
              To the extent permitted by applicable law, you waive any right to participate in a
              class action lawsuit or class-wide arbitration against Yapper.
            </p>
          </section>

          <section id="s16">
            <h2>16. Changes to These Terms</h2>
            <p>
              We may modify these Terms from time to time. When we make material changes, we will
              notify you via in-app notification and email at least 30 days before the new Terms take
              effect. Material changes include changes to your rights, our liability, or the dispute
              resolution process.
            </p>
            <p>
              Your continued use of the Service after the effective date of the revised Terms
              constitutes your acceptance of the changes. If you do not agree to the new Terms, you
              must stop using the Service before the changes take effect.
            </p>
          </section>

          <section id="s17">
            <h2>17. Contact</h2>
            <p>
              If you have questions about these Terms, please contact:
            </p>
            <div class="contact-grid">
              <div>
                <span class="label">Legal Inquiries</span>
                <a href="mailto:legal@yapperhq.com">legal@yapperhq.com</a>
              </div>
              <div>
                <span class="label">Trust &amp; Safety</span>
                <a href="mailto:safety@yapperhq.com">safety@yapperhq.com</a>
              </div>
              <div>
                <span class="label">DMCA / IP</span>
                <a href="mailto:legal@yapperhq.com">legal@yapperhq.com</a>
              </div>
              <div>
                <span class="label">Mailing Address</span>
                <span>Yapper Technologies, Inc., KwaZulu-Natal, South Africa</span>
              </div>
            </div>
          </section>

          <footer class="legal-footer-note">
            <p>© 2026 Yapper Technologies, Inc. All rights reserved.</p>
            <p>These Terms of Service were last updated on March 16, 2026.</p>
          </footer>

        </article>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal-page {
    padding: clamp(60px, 8vw, 120px) 0 clamp(60px, 8vw, 100px);
  }

  .legal-header {
    max-width: 780px;
    margin-bottom: 56px;
  }

  .legal-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-light);
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.3);
    border-radius: var(--radius-full);
    padding: 4px 12px;
    margin-bottom: 20px;
  }

  .legal-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
  }

  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
  }

  .legal-meta .sep { color: var(--color-border-light); }
  .legal-meta a { color: var(--color-brand-light); text-decoration: none; }
  .legal-meta a:hover { text-decoration: underline; }

  .legal-intro {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    max-width: 640px;
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 56px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .legal-layout { grid-template-columns: 1fr; }
    .toc { display: none; }
  }

  .toc {
    position: sticky;
    top: 100px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .toc-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .toc ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .toc a {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    display: block;
    padding: 3px 0;
    transition: color var(--transition-fast);
  }

  .toc a:hover { color: var(--color-brand-light); }

  .legal-body { min-width: 0; }

  .legal-body section {
    margin-bottom: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--color-border);
  }

  .legal-body section:last-of-type { border-bottom: none; }

  .legal-body h2 {
    font-size: 1.375rem;
    font-weight: 700;
    margin-bottom: 16px;
    scroll-margin-top: 100px;
  }

  .legal-body h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 24px 0 10px;
    color: var(--color-text-primary);
  }

  .legal-body p {
    color: var(--color-text-secondary);
    margin-bottom: 12px;
    line-height: 1.7;
    max-width: 72ch;
  }

  .legal-body p:last-child { margin-bottom: 0; }

  .legal-body ul, .legal-body ol {
    color: var(--color-text-secondary);
    padding-left: 20px;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .legal-body li { line-height: 1.65; }

  .legal-body a { color: var(--color-brand-light); text-decoration: none; }
  .legal-body a:hover { text-decoration: underline; }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin-top: 16px;
  }

  .contact-grid > div {
    display: flex;
    gap: 16px;
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .label {
    min-width: 160px;
    font-weight: 600;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .contact-grid a { color: var(--color-brand-light); text-decoration: none; }
  .contact-grid a:hover { text-decoration: underline; }

  .legal-footer-note {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
