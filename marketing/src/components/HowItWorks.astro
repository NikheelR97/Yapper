---
const steps = [
  {
    num: '01',
    title: 'Create your account',
    body: 'Sign up with email or continue with Discord or Google. Your identity keys are generated on your device; we never see them.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  },
  {
    num: '02',
    title: 'Add your people',
    body: 'Invite friends via link, username, or QR code. Join community servers to find your crowd. Each connection gets its own encrypted channel.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 1-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    num: '03',
    title: 'Start yapping',
    body: 'Text, voice, video, canvas: all E2EE, all on one screen. Available now on the web and desktop, with iOS and Android coming soon.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
];
---

<section class="section how" id="how-it-works">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Three steps to your first<br /><span class="gradient-text">encrypted message.</span></h2>
    </div>

    <div class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="step-icon">{<Fragment set:html={s.icon} />}</div>
          <div class="step-num">{s.num}</div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
          {i < steps.length - 1 && <div class="connector" aria-hidden="true" />}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    position: relative;
  }

  @media (max-width: 700px) {
    .steps { grid-template-columns: 1fr; }
    .connector { display: none; }
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    position: relative;
  }

  .step-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(167,139,250,0.08));
    border: 1px solid rgba(167,139,250,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-light);
    flex-shrink: 0;
  }

  .step-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-brand-light);
    text-transform: uppercase;
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .step-body {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 300px;
  }

  /* Horizontal connector spanning the 2rem grid gap, centered on the
     72px step icon (top: 36px). Only rendered between steps. */
  .connector {
    display: none;
  }

  @media (min-width: 701px) {
    .connector {
      display: block;
      position: absolute;
      top: 36px;
      left: 100%;
      width: 2rem;
      height: 1px;
      background: linear-gradient(90deg, rgba(167,139,250,0.3), rgba(167,139,250,0.05));
    }
  }
</style>
