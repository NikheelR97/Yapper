---
/*
  AppShowcase — the "see the room" moment.

  A high-fidelity HTML/CSS recreation of the Yapper desktop app: server rail →
  channel list → an encrypted DM thread with presence, a voice Yap, a typing
  indicator, and the composer. Rendered as real markup (not a screenshot) so it
  stays crisp at every density and tracks the brand tokens exactly.

  One Glow Rule: the violet glow lives only on this window. Everything inside
  uses the tonal near-black ramp; violet is rationed to the active channel, the
  send control, and the lock affordance.
*/

const servers = [
  { initials: 'YH', label: 'Yapper HQ', active: false },
  { initials: 'DM', label: 'Direct messages', active: true, brand: true },
  { initials: 'RG', label: 'Rock Climbing', active: false },
  { initials: 'ST', label: 'Study Group', active: false },
];

const dms = [
  { name: 'Maya Okafor', status: 'online', active: true, initials: 'MO' },
  { name: 'Dev squad', status: '3 online', active: false, group: true, initials: 'DS' },
  { name: 'Theo Park', status: 'idle', active: false, initials: 'TP' },
  { name: 'Mom', status: 'offline', active: false, initials: 'M' },
];
---

<section class="showcase section" id="product" aria-labelledby="showcase-heading">
  <div class="container">
    <header class="showcase-head">
      <div class="badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Encrypted, end to end
      </div>
      <h2 id="showcase-heading" class="showcase-title">See the room before you move in.</h2>
      <p class="showcase-sub">
        Servers, DMs, voice Yaps, and live canvases in one window. Every message
        below is ciphertext on our servers; it only becomes readable on the
        devices in the conversation.
      </p>
    </header>

    <div class="window-frame">
      <div class="window" role="img" aria-label="The Yapper desktop app showing an encrypted direct-message conversation with Maya Okafor, including a voice Yap and a typing indicator.">
        <!-- Title bar -->
        <div class="titlebar" aria-hidden="true">
          <span class="dot dot--r"></span>
          <span class="dot dot--y"></span>
          <span class="dot dot--g"></span>
          <span class="titlebar-label">Yapper</span>
        </div>

        <div class="app" aria-hidden="true">
          <!-- Server rail -->
          <nav class="rail">
            {servers.map((s) => (
              <span class={`rail-icon ${s.active ? 'is-active' : ''} ${s.brand ? 'rail-icon--brand' : ''}`}>{s.initials}</span>
            ))}
            <span class="rail-add">+</span>
          </nav>

          <!-- Channel / DM list -->
          <aside class="sidebar">
            <div class="sidebar-head">
              <span class="sidebar-title">Messages</span>
              <span class="sidebar-search">Search…</span>
            </div>
            <ul class="dm-list">
              {dms.map((d) => (
                <li class={`dm ${d.active ? 'is-active' : ''}`}>
                  <span class="avatar">
                    {d.initials}
                    <span class={`presence presence--${d.status.includes('online') ? 'online' : d.status === 'idle' ? 'idle' : 'offline'}`}></span>
                  </span>
                  <span class="dm-text">
                    <span class="dm-name">{d.name}</span>
                    <span class="dm-status">{d.status}</span>
                  </span>
                </li>
              ))}
            </ul>
            <div class="self">
              <span class="avatar avatar--self">YOU<span class="presence presence--online"></span></span>
              <span class="dm-text">
                <span class="dm-name">you</span>
                <span class="dm-status">keys verified</span>
              </span>
            </div>
          </aside>

          <!-- Conversation -->
          <main class="chat">
            <header class="chat-head">
              <span class="chat-peer">
                <span class="avatar avatar--lg">MO<span class="presence presence--online"></span></span>
                <span class="chat-peer-text">
                  <span class="chat-name">Maya Okafor</span>
                  <span class="chat-meta">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    End-to-end encrypted
                  </span>
                </span>
              </span>
              <span class="chat-actions">
                <span class="chat-act" title="Voice call">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <span class="chat-act" title="Video">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                </span>
              </span>
            </header>

            <div class="thread">
              <div class="day-rule"><span>Today</span></div>

              <div class="msg">
                <span class="avatar avatar--msg">MO</span>
                <div class="msg-body">
                  <span class="msg-meta"><span class="msg-author">Maya</span><span class="msg-time">9:41</span></span>
                  <div class="bubble">did the climbing gym change their hours? i swear it said 10 last week 🧗</div>
                </div>
              </div>

              <div class="msg msg--me">
                <div class="msg-body">
                  <span class="msg-meta"><span class="msg-time">9:41</span><span class="msg-author">you</span></span>
                  <div class="bubble bubble--me">yeah they pushed it to 9 on weekdays. sending the new schedule</div>
                </div>
              </div>

              <div class="msg msg--me">
                <div class="msg-body">
                  <span class="msg-meta"><span class="msg-time">9:42</span><span class="msg-author">you</span></span>
                  <!-- Voice Yap, inline -->
                  <div class="bubble bubble--me bubble--yap">
                    <span class="yap-play">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                    <span class="yap-wave" aria-hidden="true">
                      {Array.from({ length: 28 }).map((_, i) => (
                        <span style={`height:${20 + Math.round(Math.abs(Math.sin(i * 0.9)) * 70)}%`}></span>
                      ))}
                    </span>
                    <span class="yap-time">0:11</span>
                  </div>
                </div>
              </div>

              <div class="msg">
                <span class="avatar avatar--msg">MO</span>
                <div class="msg-body">
                  <span class="msg-meta"><span class="msg-author">Maya</span><span class="msg-time">9:43</span></span>
                  <div class="typing"><span></span><span></span><span></span></div>
                </div>
              </div>
            </div>

            <div class="composer">
              <span class="composer-add">+</span>
              <span class="composer-input">Message Maya, privately…</span>
              <span class="composer-send">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </span>
            </div>
          </main>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase { padding-top: clamp(40px, 6vw, 72px); }

  .showcase-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .showcase-title {
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    max-width: 18ch;
    text-wrap: balance;
  }

  .showcase-sub {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    max-width: 560px;
    line-height: 1.7;
  }

  /* --- Window shell ------------------------------------------------- */
  .window-frame {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* The single rationed glow on the page's product surface. */
  .window-frame::before {
    content: '';
    position: absolute;
    inset: -8% 4% auto 4%;
    height: 70%;
    background: radial-gradient(60% 100% at 50% 0%, rgba(124, 58, 237, 0.30), transparent 70%);
    filter: blur(30px);
    z-index: 0;
    pointer-events: none;
  }

  .window {
    position: relative;
    z-index: 1;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg-base);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 40px 80px -32px rgba(0, 0, 0, 0.8),
      0 0 60px rgba(124, 58, 237, 0.12);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot--r { background: #ff5f57; }
  .dot--y { background: #febc2e; }
  .dot--g { background: #28c840; }
  .titlebar-label {
    margin-left: auto;
    margin-right: auto;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
    transform: translateX(-16px);
  }

  .app {
    display: grid;
    grid-template-columns: 60px 230px 1fr;
    height: 520px;
  }

  /* --- Server rail -------------------------------------------------- */
  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 0;
    background: var(--color-bg-base);
    border-right: 1px solid var(--color-border);
  }
  .rail-icon {
    width: 40px; height: 40px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-bg-elevated);
    color: var(--color-text-secondary);
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.02em;
    position: relative;
    transition: border-radius var(--transition-base);
  }
  .rail-icon.is-active { border-radius: 12px; }
  .rail-icon.is-active::before {
    content: '';
    position: absolute;
    left: -0.85rem; top: 50%;
    transform: translateY(-50%);
    width: 4px; height: 22px;
    border-radius: 0 4px 4px 0;
    background: var(--color-text-primary);
  }
  .rail-icon--brand {
    background: var(--color-brand);
    color: #fff;
  }
  .rail-icon--brand.is-active::before { background: var(--color-brand-light); }
  .rail-add {
    width: 40px; height: 40px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    border: 1px dashed var(--color-border-light);
    color: var(--color-text-muted);
    font-size: 1.1rem; font-weight: 400;
    margin-top: 0.15rem;
  }

  /* --- Sidebar ------------------------------------------------------ */
  .sidebar {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-surface);
    border-right: 1px solid var(--color-border);
    min-width: 0;
  }
  .sidebar-head {
    padding: 1rem 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    border-bottom: 1px solid var(--color-border);
  }
  .sidebar-title { font-size: 0.95rem; font-weight: 700; color: var(--color-text-primary); }
  .sidebar-search {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.6rem;
  }
  .dm-list { list-style: none; padding: 0.5rem; display: flex; flex-direction: column; gap: 0.15rem; flex: 1; }
  .dm {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.45rem 0.55rem;
    border-radius: var(--radius-md);
    min-width: 0;
  }
  .dm.is-active { background: var(--color-bg-elevated); }
  .dm-text { display: flex; flex-direction: column; min-width: 0; }
  .dm-name {
    font-size: 0.85rem; font-weight: 600; color: var(--color-text-primary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dm.is-active .dm-name { color: var(--color-text-primary); }
  .dm:not(.is-active) .dm-name { color: var(--color-text-secondary); }
  .dm-status { font-size: 0.72rem; color: var(--color-text-muted); }

  .avatar {
    position: relative;
    width: 34px; height: 34px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--color-bg-elevated), var(--color-bg-card));
    border: 1px solid var(--color-border-light);
    color: var(--color-text-secondary);
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.03em;
    flex-shrink: 0;
  }
  .avatar--self { background: linear-gradient(135deg, var(--color-brand-dark), var(--color-brand)); color: #fff; border-color: transparent; }
  .avatar--lg { width: 38px; height: 38px; font-size: 0.66rem; }
  .avatar--msg { width: 36px; height: 36px; font-size: 0.64rem; align-self: flex-start; }

  .presence {
    position: absolute;
    right: -1px; bottom: -1px;
    width: 11px; height: 11px;
    border-radius: 50%;
    border: 2px solid var(--color-bg-surface);
  }
  .presence--online { background: #28c840; }
  .presence--idle { background: #febc2e; }
  .presence--offline { background: var(--color-text-muted); }

  .self {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.7rem 0.85rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-base);
  }
  .self .presence { border-color: var(--color-bg-base); }

  /* --- Chat --------------------------------------------------------- */
  .chat {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-base);
    min-width: 0;
  }
  .chat-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .chat-peer { display: flex; align-items: center; gap: 0.7rem; }
  .chat-peer .presence { border-color: var(--color-bg-base); }
  .chat-peer-text { display: flex; flex-direction: column; gap: 0.1rem; }
  .chat-name { font-size: 0.95rem; font-weight: 700; color: var(--color-text-primary); }
  .chat-meta {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.72rem; color: var(--color-brand-light); font-weight: 600;
  }
  .chat-actions { display: flex; gap: 0.4rem; }
  .chat-act {
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
  }

  .thread {
    flex: 1;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    overflow: hidden;
  }
  .day-rule {
    display: flex; align-items: center; gap: 0.75rem;
    color: var(--color-text-muted); font-size: 0.7rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .day-rule::before, .day-rule::after {
    content: ''; flex: 1; height: 1px; background: var(--color-border);
  }

  .msg { display: flex; gap: 0.65rem; max-width: 78%; }
  .msg--me { margin-left: auto; flex-direction: row-reverse; }
  .msg-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .msg--me .msg-body { align-items: flex-end; }
  .msg-meta { display: flex; align-items: baseline; gap: 0.45rem; }
  .msg-author { font-size: 0.8rem; font-weight: 600; color: var(--color-text-secondary); }
  .msg-time {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.66rem; color: var(--color-text-muted);
  }

  .bubble {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-primary);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.8rem;
    border-radius: 4px 14px 14px 14px;
  }
  .bubble--me {
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-dark));
    border-color: transparent;
    color: #fff;
    border-radius: 14px 4px 14px 14px;
  }

  .bubble--yap {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.7rem;
  }
  .yap-play {
    width: 26px; height: 26px; flex-shrink: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
  }
  .yap-wave {
    display: flex; align-items: center; gap: 2px;
    height: 24px; min-width: 130px;
  }
  .yap-wave span {
    width: 2.5px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.55);
  }
  .yap-wave span:nth-child(-n+11) { background: #fff; }
  .yap-time {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.68rem; color: rgba(255, 255, 255, 0.85);
  }

  .typing {
    display: inline-flex; gap: 4px;
    padding: 0.7rem 0.85rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 4px 14px 14px 14px;
    width: fit-content;
  }
  .typing span {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-text-muted);
    animation: typing-bounce 1.3s ease-in-out infinite;
  }
  .typing span:nth-child(2) { animation-delay: 0.18s; }
  .typing span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .composer {
    display: flex; align-items: center; gap: 0.6rem;
    margin: 0 1.1rem 1.1rem;
    padding: 0.55rem 0.65rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }
  .composer-add {
    width: 28px; height: 28px; flex-shrink: 0;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-bg-elevated);
    color: var(--color-text-secondary);
    font-size: 1rem;
  }
  .composer-input { flex: 1; font-size: 0.85rem; color: var(--color-text-muted); }
  .composer-send {
    width: 32px; height: 32px; flex-shrink: 0;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-brand);
    color: #fff;
  }

  /* --- Responsive --------------------------------------------------- */
  @media (max-width: 860px) {
    .app { grid-template-columns: 56px 1fr; height: 480px; }
    .sidebar { display: none; }
  }
  @media (max-width: 520px) {
    .app { grid-template-columns: 48px 1fr; height: 440px; }
    .rail { padding: 0.6rem 0; gap: 0.5rem; }
    .rail-icon, .rail-add { width: 34px; height: 34px; border-radius: 11px; font-size: 0.62rem; }
    .msg { max-width: 88%; }
    .yap-wave { min-width: 90px; }
    .window-frame::before { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing span { animation: none; opacity: 0.7; }
  }
</style>
