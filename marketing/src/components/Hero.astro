---
import WishlistForm from './WishlistForm.svelte';
---

<section class="hero section" id="hero">
  <div class="container hero-inner">

    <!-- Left: copy -->
    <div class="hero-copy">
      <div class="badge">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M6 1L7.5 4.5H11L8.25 6.75L9.25 10.25L6 8.25L2.75 10.25L3.75 6.75L1 4.5H4.5L6 1Z" fill="currentColor"/>
        </svg>
        Fully Encrypted · Zero Knowledge
      </div>

      <h1 class="hero-title">
        A New Way<br />to <span class="gradient-text">Yap.</span>
      </h1>

      <p class="hero-sub">
        End-to-end encrypted messages, voice <strong>Yaps</strong>, video
        <strong>Clips</strong>, and live canvases, all in one place.
        Not even we can read your chats.
      </p>

      <div class="hero-cta-row">
        <a href="https://app.yapperhq.com/register" class="btn-primary">Get started free</a>
        <a href="#platforms" class="btn-ghost">Download apps</a>
      </div>

      <WishlistForm client:load apiUrl={import.meta.env.PUBLIC_API_URL ?? ''} />

      <p class="hero-legal">
        Free forever. No credit card required.
      </p>
    </div>

    <!-- Right: sphere -->
    <div class="hero-visual" aria-hidden="true">
      <div class="sphere-wrap">
        <div class="sphere"></div>
        <div class="sphere-ring ring-1"></div>
        <div class="sphere-ring ring-2"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  /* Radial glow behind sphere */
  .hero::after {
    content: '';
    position: absolute;
    right: -5%;
    top: 50%;
    transform: translateY(-50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(124,58,237,0.18) 0%, transparent 70%);
    pointer-events: none;
    border-radius: 50%;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero::after { display: none; }
  }

  /* --- Copy --- */
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .hero-copy { align-items: center; }
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.175rem);
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: 1.7;
  }

  .hero-sub strong {
    color: var(--color-brand-light);
    font-weight: 600;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero-cta-row { justify-content: center; }
  }

  .hero-legal {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: -0.5rem;
  }

  /* --- Sphere --- */
  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sphere-wrap {
    position: relative;
    width: 360px;
    height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sphere {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #c4b5fd, #7c3aed 40%, #2e1065 80%);
    box-shadow:
      0 0 60px rgba(124,58,237,0.5),
      0 0 120px rgba(124,58,237,0.25),
      inset 0 -20px 40px rgba(0,0,0,0.4);
    animation: pulse 4s ease-in-out infinite;
    position: relative;
    z-index: 2;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 60px rgba(124,58,237,0.5), 0 0 120px rgba(124,58,237,0.25), inset 0 -20px 40px rgba(0,0,0,0.4); }
    50%       { box-shadow: 0 0 80px rgba(124,58,237,0.7), 0 0 160px rgba(124,58,237,0.35), inset 0 -20px 40px rgba(0,0,0,0.4); }
  }

  .sphere-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(167,139,250,0.12);
    animation: spin linear infinite;
  }

  .ring-1 {
    width: 300px; height: 300px;
    animation-duration: 18s;
    border-color: rgba(167,139,250,0.1);
  }

  .ring-2 {
    width: 356px; height: 356px;
    animation-duration: 30s;
    animation-direction: reverse;
    border-color: rgba(167,139,250,0.06);
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .orb {
    position: absolute;
    border-radius: 50%;
    animation: orbit linear infinite;
  }

  .orb-1 {
    width: 10px; height: 10px;
    background: #a78bfa;
    box-shadow: 0 0 10px #a78bfa;
    top: 30px; left: 50%;
    transform-origin: 0 120px;
    animation-duration: 18s;
  }

  .orb-2 {
    width: 6px; height: 6px;
    background: #7c3aed;
    box-shadow: 0 0 8px #7c3aed;
    top: 10px; left: 50%;
    transform-origin: 0 168px;
    animation-duration: 30s;
    animation-direction: reverse;
  }

  @keyframes orbit { to { transform: rotate(360deg); } }

  @media (max-width: 900px) {
    .sphere-wrap { width: 260px; height: 260px; }
    .sphere      { width: 180px; height: 180px; }
    .ring-1      { width: 220px; height: 220px; }
    .ring-2      { width: 258px; height: 258px; }
  }

  /* --- Orchestrated page-load entrance ---------------------------------
     One rehearsed reveal: the copy column rises in sequence while the
     sphere scales up and sharpens from a soft blur. CSS-only and ungated,
     so it always plays (no IntersectionObserver, no class toggle that
     could ship the hero blank on a hidden tab or headless render). Uses
     fill-mode: both so each element holds its hidden start during its
     delay instead of flashing in first. */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes sphere-in {
    from { opacity: 0; transform: scale(0.82); filter: blur(10px); }
    to   { opacity: 1; transform: scale(1);    filter: blur(0); }
  }

  .hero-copy > * {
    animation: hero-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-copy > *:nth-child(1) { animation-delay: 0.06s; }
  .hero-copy > *:nth-child(2) { animation-delay: 0.14s; }
  .hero-copy > *:nth-child(3) { animation-delay: 0.22s; }
  .hero-copy > *:nth-child(4) { animation-delay: 0.30s; }
  .hero-copy > *:nth-child(5) { animation-delay: 0.38s; }
  .hero-copy > *:nth-child(6) { animation-delay: 0.46s; }

  .sphere-wrap {
    animation: sphere-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.12s;
  }

  /* Reduced motion: skip the choreography entirely, show the final state.
     Explicit override (not just the global duration kill-switch) so no
     animation-delay can leave an element briefly hidden. */
  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .sphere-wrap {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
