---
const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1" fill="currentColor" stroke="none"/></svg>`,
    title: 'Signal Encryption',
    body: 'Every message uses the Signal Protocol: X3DH key exchange plus Double Ratchet. Zero knowledge. Not even we can read your chats.',
    accent: 'var(--color-brand-light)',
  },
  // Bento order: span drives the asymmetric grid below the lead card.
  // 3-col grid packs as: [Servers 2 | Video 1] · [Cross 1 | Parental 2] · [Bots 3].
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Servers & Channels',
    body: 'Create community spaces with text, voice, and media channels. Sender Keys make group E2EE as fast as unencrypted, so a 500-person channel stays as snappy as a DM.',
    accent: 'var(--color-brand-light)',
    span: 2,
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>`,
    title: 'Video Clips',
    body: 'Send short encrypted video messages up to 60 seconds. Client-side AES-256-GCM encryption before upload.',
    accent: 'var(--color-brand-light)',
    span: 1,
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: 'Cross-Platform',
    body: 'On the web and on macOS, Windows, and Linux today, with iOS and Android coming soon. Your chats follow you everywhere.',
    accent: 'var(--color-brand-light)',
    span: 1,
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: 'Parental Controls',
    body: 'Parents see only metadata, never message content. Friend requests and server joins for a child need a guardian to approve them first.',
    // Safety-green is the one functional hue kept outside the violet system.
    accent: '#4ade80',
    span: 2,
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="M9 10l2 2 4-4"/></svg>`,
    title: 'Custom Bots',
    body: 'Build or import bots to automate moderation, run games, or bridge other services. Bring your Discord bots across with the built-in importer.',
    accent: 'var(--color-brand-light)',
    span: 3,
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Every feature you came for,<br /><span class="gradient-text">encrypted by default.</span></h2>
      <p class="section-sub">The chat features you already rely on, with the encryption running quietly underneath every one of them.</p>
    </div>

    {(() => { const [lead, ...rest] = features; return (
      <div class="feature-layout">
        <article class="card card--featured" style={`--accent: ${lead.accent}`}>
          <div class="card-icon" set:html={lead.icon} />
          <div class="card-featured-text">
            <h3 class="card-title">{lead.title}</h3>
            <p class="card-body">{lead.body}</p>
          </div>
        </article>

        <div class="bento">
          {rest.map((f) => (
            <article
              class={`card ${f.span >= 2 ? 'card--wide' : ''}`}
              style={`--accent: ${f.accent}; --span: ${f.span}`}
            >
              <div class="card-icon" set:html={f.icon} />
              <div class="card-text">
                <h3 class="card-title">{f.title}</h3>
                <p class="card-body">{f.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    ); })()}
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .section-sub {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    max-width: 520px;
    line-height: 1.7;
  }

  .feature-layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Bento: a fixed 3-track grid the cards span unevenly, so the section
     reads as a deliberate composition rather than a row of identical tiles. */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card {
    grid-column: span var(--span, 1);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .card-text { display: flex; flex-direction: column; gap: 0.5rem; }

  /* Wide cards switch to a horizontal layout so they are structurally
     distinct from the tall single-column cards, not just stretched copies. */
  .card--wide {
    flex-direction: row;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.75rem 2rem;
  }
  .card--wide .card-body { max-width: 52ch; }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--color-border));
    transform: translateY(-2px);
  }

  /* Featured card: the core privacy promise carries the most visual weight
     and earns the rationed violet glow (One Glow Rule). */
  .card--featured {
    flex-direction: row;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.10), var(--color-bg-card) 55%);
    border-color: rgba(167, 139, 250, 0.28);
    box-shadow: 0 0 40px rgba(124, 58, 237, 0.08);
  }

  .card--featured .card-icon {
    width: 56px;
    height: 56px;
  }

  .card--featured .card-featured-text {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .card--featured .card-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .card--featured .card-body {
    font-size: 1rem;
    max-width: 62ch;
  }

  @media (max-width: 560px) {
    .card--featured { flex-direction: column; }
  }

  .card-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    flex-shrink: 0;
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .card-body {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    flex: 1;
  }

  /* Tablet: 2 tracks. Wide cards fill the row; narrow cards pair up. */
  @media (max-width: 820px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .card { grid-column: span 1; }
    .card--wide { grid-column: span 2; }
  }

  /* Mobile: single column; wide cards stack icon over text. */
  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .card, .card--wide { grid-column: span 1; }
    .card--wide { flex-direction: column; gap: 0.875rem; padding: 1.75rem; }
  }
</style>
